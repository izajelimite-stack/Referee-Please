# Copia este archivo a .env y ajústalo:  cp .env.example .env

# Versión de Minecraft (LATEST o un número, p. ej. 1.21.4)
VERSION=LATEST

# Memoria para el servidor (deja ~1 GB libre para el sistema)
MEMORY=3G

# Datos del servidor
SERVER_NAME=Referee Please
MOTD=Bienvenido al servidor!
MAX_PLAYERS=10
DIFFICULTY=normal
MODE=survival
VIEW_DISTANCE=10

# Acceso: pon tu nombre de usuario de Minecraft
OPS=TuUsuario
# Lista blanca (recomendado): solo entran los nombres listados, separados por comas
ENABLE_WHITELIST=true
WHITELIST=TuUsuario

# Contraseña RCON (consola remota y backups). ¡Cámbiala!
RCON_PASSWORD=cambia-esta-contrasena

# --- Opcional: permitir jugadores de Bedrock (móvil, consola, Windows 10) ---
# Descomenta la siguiente línea para instalar Geyser + Floodgate
# MODRINTH_PROJECTS=geyser,floodgate
